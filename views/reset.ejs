<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <title>비밀번호 재설정</title>
</head>
<body>
  <h1>비밀번호 재설정</h1>
  <% if (error) { %>
    <p style="color:red"><%= error %></p>
  <% } %>
  <form method="POST" action="/auth/reset">
    <label>새 비밀번호: <input type="password" name="newPassword" required></label><br>
    <label>비밀번호 확인: <input type="password" name="confirmPassword" required></label><br>
    <button type="submit">비밀번호 변경</button>
  </form>
  <p><a href="/auth/login">로그인으로 돌아가기</a></p>
</body>
</html>