<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <title>비밀번호 찾기</title>
</head>
<body>
  <h1>비밀번호 찾기</h1>
  <% if (error) { %>
    <p style="color:red"><%= error %></p>
  <% } %>
  <form method="POST" action="/auth/forgot">
    <label>아이디: <input name="id" required></label><br>
    <label>이름: <input name="name" required></label><br>
    <label>학번: <input name="studentId" required></label><br>
    <button type="submit">본인 인증</button>
  </form>
  <p><a href="/auth/login">로그인으로 돌아가기</a></p>
</body>
</html>