<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <title><%= room.name %> 채팅방</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/style/chat_room_style.css">
</head>
<body class="bg-gray-100 font-sans">
  <div class="max-w-7xl mx-auto p-6 space-y-6">
    <h2 class="text-3xl font-bold text-gray-800"><%= room.name %> 채팅방</h2>
    <!-- 방 삭제 버튼 (EJS 조건문) -->
    <% if (user.user_id === room.owner_id) { %>
      <form action="/chat/<%= room.id %>/delete" method="POST" style="display:inline;">
        <button id="deleteRoomBtn"
                class="mt-2 bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600">
          방 삭제
        </button>
      </form>
    <% } %>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-4">
      <!-- 🎨 그림판 (3/4) -->
      <div class="lg:col-span-3 space-y-4">
        <!-- 툴바 -->
        <div class="flex flex-wrap items-center justify-between bg-white p-3 rounded-lg shadow-md sticky top-6 z-10">
          <div class="flex gap-4 items-center">
            <label class="text-sm font-medium">색상</label>
            <input type="color" id="colorPicker" class="border rounded" />
            <label class="text-sm font-medium">선굵기</label>
            <input type="range" id="lineWidth" min="1" max="20" value="2" class="w-32" />
          </div>
          <div class="flex flex-wrap gap-2 mt-2 lg:mt-0">
            <button onclick="setMode('draw')" class="bg-blue-500 text-white px-3 py-1 rounded hover:bg-blue-600">그리기</button>
            <button onclick="setMode('text')" class="bg-green-500 text-white px-3 py-1 rounded hover:bg-green-600">텍스트</button>
            <button onclick="saveTextToCanvas()" class="bg-yellow-500 text-white px-3 py-1 rounded hover:bg-yellow-600">텍스트 고정</button>
            <button onclick="clearCanvas()" class="bg-red-500 text-white px-3 py-1 rounded hover:bg-red-600">초기화</button>
          </div>
        </div>

        <!-- 캔버스 -->
        <div id="canvasWrapper" class="relative border rounded-xl shadow bg-white h-[700px] overflow-hidden">
          <canvas id="canvas" width="1000" height="700" class="w-full h-full"></canvas>
        </div>
      </div>

      <!-- 💬 채팅 + 유저 목록 -->
      <div class="lg:col-span-1 space-y-4">
        <!-- 채팅 -->
        <div class="flex flex-col h-[500px] bg-white rounded-xl shadow-md p-4">
          <h3 class="text-xl font-semibold text-gray-700 mb-2">채팅</h3>
          <ul id="messages" class="flex-1 overflow-y-auto space-y-2 text-sm border-t pt-2 pr-2"></ul>
          <form id="chat-form" class="flex mt-4 gap-2">
            <input id="msgInput" autocomplete="off" placeholder="메시지 입력..." class="flex-1 border px-3 py-2 rounded-md" />
            <button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">전송</button>
          </form>
        </div>

        <!-- 참여자 목록 -->
        <div class="bg-white rounded-xl shadow-md p-4 max-h-[300px] overflow-y-auto transition-all duration-300">
          <h3 id="userListToggle" class="text-xl font-semibold text-gray-700 cursor-pointer select-none mb-2">
            참여자 <span class="text-sm text-gray-400 ml-1">(클릭하여 숨기기)</span>
          </h3>
          <ul id="userList" class="space-y-1 text-sm text-gray-800"></ul>
        </div>
      </div>
    </div>
  </div>

  <!-- 🔌 Script -->
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    const roomId = "<%= room.id %>";
    const user = "<%= user.user_id %>";
    socket.emit('joinRoom', roomId);

    const canvas = document.getElementById("canvas");
    const ctx = canvas.getContext("2d");
    const wrapper = document.getElementById("canvasWrapper");
    let drawing = false, mode = "draw";
    ctx.lineCap = "round";

    canvas.addEventListener("mousedown", (e) => {
      if (mode === "draw") {
        drawing = true;
        ctx.beginPath();
        ctx.moveTo(e.offsetX, e.offsetY);
        socket.emit('drawing', { roomId, type: 'beginPath', x: e.offsetX, y: e.offsetY, color: color(), lineWidth: width() });
      } else if (mode === "text") {
        createTextBox(e.offsetX, e.offsetY);
      }
    });

    canvas.addEventListener("mousemove", (e) => {
      if (drawing && mode === "draw") {
        ctx.strokeStyle = color();
        ctx.lineWidth = width();
        ctx.lineTo(e.offsetX, e.offsetY);
        ctx.stroke();
        socket.emit('drawing', { roomId, type: 'stroke', x: e.offsetX, y: e.offsetY, color: color(), lineWidth: width() });
      }
    });

    canvas.addEventListener("mouseup", () => {
      if (drawing && mode === "draw") {
        drawing = false;
        socket.emit('drawing', { roomId, type: 'endPath' });
      }
    });

    function color() {
      return document.getElementById("colorPicker").value;
    }

    function width() {
      return document.getElementById("lineWidth").value;
    }

    function setMode(m) {
      mode = m;
    }

    function clearCanvas() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      document.querySelectorAll(".text-box").forEach(box => box.remove());
      socket.emit('drawing', { roomId, type: 'clear' });
    }

    function createTextBox(x, y) {
      const box = document.createElement("div");
      box.className = "text-box";
      box.style.left = `${x}px`;
      box.style.top = `${y}px`;
      box.style.width = "150px";
      box.style.height = "50px";

      const textarea = document.createElement("textarea");
      textarea.className = "w-full h-full border-none resize-none bg-transparent focus:outline-none";
      box.appendChild(textarea);
      wrapper.appendChild(box);
      makeDraggable(box);
      textarea.focus();
    }

    function saveTextToCanvas() {
      document.querySelectorAll(".text-box").forEach((box) => {
        const text = box.querySelector("textarea").value;
        const x = parseInt(box.style.left, 10);
        const y = parseInt(box.style.top, 10) + 16;
        ctx.font = "16px sans-serif";
        ctx.fillStyle = color();
        text.split("\n").forEach((line, i) => ctx.fillText(line, x, y + i * 20));
        socket.emit('drawing', { roomId, type: 'text', x, y, text, color: color() });
        box.remove();
      });
    }

    function makeDraggable(el) {
      let isDragging = false, offsetX = 0, offsetY = 0;
      el.addEventListener("mousedown", (e) => {
        if (e.target.tagName.toLowerCase() === "textarea") return;
        isDragging = true;
        offsetX = e.offsetX;
        offsetY = e.offsetY;
      });
      document.addEventListener("mousemove", (e) => {
        if (isDragging) {
          el.style.left = `${e.pageX - wrapper.offsetLeft - offsetX}px`;
          el.style.top = `${e.pageY - wrapper.offsetTop - offsetY}px`;
        }
      });
      document.addEventListener("mouseup", () => { isDragging = false; });
    }

    socket.on("drawing", (data) => {
      ctx.strokeStyle = data.color;
      ctx.lineWidth = data.lineWidth;
      switch (data.type) {
        case "beginPath":
          ctx.beginPath();
          ctx.moveTo(data.x, data.y);
          break;
        case "stroke":
          ctx.lineTo(data.x, data.y);
          ctx.stroke();
          break;
        case "endPath":
          ctx.closePath();
          break;
        case "clear":
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          document.querySelectorAll(".text-box").forEach(b => b.remove());
          break;
        case "text":
          ctx.font = "16px sans-serif";
          ctx.fillStyle = data.color;
          data.text.split("\n").forEach((line, i) => ctx.fillText(line, data.x, data.y + i * 20));
          break;
      }
    });

    socket.on('initDrawing', (history) => {
      history.forEach(data => {
        // 위의 switch와 동일하게 처리
        switch (data.type) {
          case 'beginPath':
            ctx.beginPath();
            ctx.moveTo(data.x, data.y);
            break;
          case 'stroke':
            ctx.strokeStyle = data.color;
            ctx.lineWidth = data.lineWidth;
            ctx.lineTo(data.x, data.y);
            ctx.stroke();
            break;
          case 'endPath':
            ctx.closePath();
            break;
          case 'clear':
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            document.querySelectorAll(".text-box").forEach(box => box.remove());
            break;
          case 'text':
            ctx.font = "16px sans-serif";
            ctx.fillStyle = data.color;
            data.text.split("\n").forEach((line, i) => {
              ctx.fillText(line, data.x, data.y + i * 20);
            });
            break;
          default:
            break;
        }
      });
    }); 

    document.getElementById("chat-form").addEventListener("submit", (e) => {
      e.preventDefault();
      const input = document.getElementById("msgInput");
      const msg = input.value.trim();
      if (!msg) return;
      socket.emit("chat message", { roomId, msg });
      input.value = "";
    });

    socket.on("chat message", (data) => {
      const li = document.createElement("li");
      li.className = data.user === user ? "text-right" : "text-left";
      const bubble = document.createElement("div");
      bubble.className = `inline-block px-3 py-2 rounded-lg max-w-[80%] ${data.user === user ? 'bg-blue-100' : 'bg-gray-200'}`;
      bubble.textContent = `${data.user}: ${data.message.msg}`;
      li.appendChild(풍선껌);
      const list = document.getElementById("messages");
      list.appendChild(li);
      list.scrollTop = list.scrollHeight;
    });

    socket.on("updateUserList", (userList) => {
      const ul = document.getElementById("userList");
      ul.innerHTML = "";
  
      userList.forEach((username) => {
        const li = document.createElement("li");
        li.className = "py-1 px-2 flex justify-between items-center rounded bg-gray-100";
  
        const nameSpan = document.createElement("span");
        nameSpan.textContent = username === user ? `${username} (나)` : username;
        li.appendChild(nameSpan);
  
        // 강퇴 버튼 - 방장만 보임, 자신 제외
        if (user === "<%= room.owner_id %>" && username !== user) {
          const kickBtn = document.createElement("button");
          kickBtn.textContent = "강퇴";
          kickBtn.className = "ml-2 bg-red-400 text-white text-xs px-2 py-1 rounded hover:bg-red-500";
          kickBtn.onclick = () => {
            if (confirm(`${username}님을 강퇴하시겠습니까?`)) {
              socket.emit("kickUser", { roomId, targetUser: username });
            }
          };
          li.appendChild(kickBtn);
        }
  
        ul.appendChild(li);
      });
    });
  
    // 방 삭제 버튼 핸들러
    const deleteRoomBtn = document.getElementById("deleteRoomBtn");
    if (deleteRoomBtn) {
      deleteRoomBtn.addEventListener("click", () => {
        if (confirm("정말로 이 방을 삭제하시겠습니까?")) {
          socket.emit("deleteRoom", roomId);
        }
      });
    }
  
    // 강퇴당했을 때
    socket.on("kicked", () => {
      alert("방장에서 강퇴당했습니다.");
      window.location.href = "/";
    });
  
    // 방 삭제되었을 때
    socket.on("roomDeleted", () => {
      alert("이 방은 삭제되었습니다.");
      window.location.href = "/";
    });

    // 참여자 토글
    const toggle = document.getElementById("userListToggle");
    const list = document.getElementById("userList");
    toggle.addEventListener("click", () => {
      const span = toggle.querySelector("span");
      list.classList.toggle("hidden");
      span.textContent = list.classList.contains("hidden") ? "(클릭하여 열기)" : "(클릭하여 숨기기)";
    });
  </script>
</body>
</html>